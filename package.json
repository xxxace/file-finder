{
  "name": "file-finder",
  "version": "1.0.0",
  "main": "dist/electron/main/index.js",
  "description": "Really simple Electron + Vue + Vite boilerplate.",
  "author": "ace",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "chcp 65001 && vite",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && electron-builder"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.9.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "file-icon-vectors": "^1.0.0",
    "naive-ui": "^2.45.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_HOST": "127.0.0.1",
      "VITE_DEV_SERVER_PORT": 3344,
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344"
    }
  },
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@seald-io/nedb": "^4.1.2",
    "dayjs": "^1.11.23",
    "fluent-ffmpeg": "^2.1.3",
    "less": "^4.9.1"
  }
}
